  "item": [
    {
      "name": "Calculate Compensation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Manuel Neuer\",\n  \"position\": \"GOALKEEPER\",\n  \"club\": \"Bayern Munich\",\n  \"baseCompensation\": 10000,\n  \"goalsScored\": 0,\n  \"assists\": 1,\n  \"cleanSheets\": 10,\n  \"saves\": 50,\n  \"tackles\": 0,\n  \"passingAccuracy\": 75,\n  \"minutesPlayed\": 1800,\n  \"yellowCards\": 1,\n  \"redCards\": 0,\n  \"matchesPlayed\": 20,\n  \"penaltiesSaved\": 2,\n  \"penaltiesScored\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/player/calculateCompensation",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "player", "calculateCompensation"]
        }
      }
    },
    {
      "name": "Create Rule - Goal Bonus",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Goal Bonus\",\n  \"description\": \"Bonus for each goal scored\",\n  \"position\": \"ANY\",\n  \"conditions\": {\n    \"all\": [{ \"fact\": \"goalsScored\", \"operator\": \"greaterThan\", \"value\": 0 }]\n  },\n  \"event\": {\n    \"type\": \"goalBonus\",\n    \"result\": { \"bonusAmount\": 200 }\n  },\n  \"priority\": 1,\n  \"isActive\": true\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/rule",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "rule"]
        }
      }
